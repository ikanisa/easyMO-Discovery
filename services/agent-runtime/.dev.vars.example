# Cloudflare Worker Environment Variables Example
# Copy this file to .dev.vars for local development
# DO NOT commit .dev.vars to git (it's in .gitignore)

# ============================================
# Required Secrets
# ============================================

# OpenAI API Key (Required)
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-...

# Supabase Configuration (Required)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# Service role key (optional, for admin operations)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ============================================
# Optional Secrets
# ============================================

# Google Gemini API Key (Optional - alternative to OpenAI)
GEMINI_API_KEY=AIzaSy...

# Google Maps API Key (Optional)
GOOGLE_MAPS_API_KEY=AIzaSy...

# SerpAPI Key (Optional - for web search)
SERPAPI_API_KEY=...

# OAuth Configuration (Optional - for ChatGPT Apps SDK)
OAUTH_CLIENT_SECRET=...

# Cron Job Authentication (Optional)
CRON_SECRET=your-secret-token-here

# ============================================
# Non-Secret Variables (can be in wrangler.toml)
# ============================================
# These are set in wrangler.toml [vars] section:
# RATE_LIMIT_MAX_REQUESTS=100
# RATE_LIMIT_WINDOW_SECONDS=60

# ============================================
# Notes
# ============================================
# - For local development: Copy to .dev.vars
# - For production: Use 'wrangler secret put VARIABLE_NAME --env production'
# - Never commit .dev.vars to git
# - See docs/deploy/env-matrix.md for complete variable matrix
