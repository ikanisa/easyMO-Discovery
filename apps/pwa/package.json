{
  "name": "@easymo/pwa",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test:e2e": "playwright test",
    "perf:lighthouse": "lighthouse http://localhost:4173 --only-categories=performance,pwa,accessibility --output=html --output-path=perf/lighthouse.html",
    "perf:budget": "node ../../scripts/check-bundle-size.js dist",
    "pages:build": "npm run build",
    "pages:deploy": "npm run build && npx wrangler pages deploy dist --project-name discovery"
  },
  "dependencies": {
    "@easymo/shared": "*",
    "@google/genai": "^1.32.0",
    "@supabase/supabase-js": "2.39.3",
    "@tanstack/react-query": "^5.66.0",
    "clsx": "2.1.0",
    "framer-motion": "^12.4.0",
    "html5-qrcode": "2.3.8",
    "lucide-react": "^0.453.0",
    "qrcode": "1.5.3",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "sonner": "1.4.3",
    "tailwind-merge": "2.2.1",
    "vaul": "^0.9.6",
    "web-vitals": "^4.2.4",
    "zustand": "4.5.2"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@vitejs/plugin-react": "^5.0.0",
    "@axe-core/playwright": "^4.9.1",
    "@playwright/test": "^1.50.1",
    "autoprefixer": "^10.4.20",
    "lighthouse": "^12.0.0",
