# Frontend Environment Variables Example
# Copy this file to .env.local for local development
# DO NOT commit .env.local to git (it's in .gitignore)

# ============================================
# Required Variables
# ============================================

# Supabase Configuration (Required)
# Get these from your Supabase project settings
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ============================================
# Optional Variables
# ============================================

# Cloudflare Worker URL (Required if ENABLE_WORKER_AGENT=true)
# This is the URL of your deployed Cloudflare Worker
VITE_WORKER_URL=https://easymo-agent-worker.your-subdomain.workers.dev

# Google Maps API Key (Optional - for SmartLocationInput component)
# Get from: https://console.cloud.google.com/apis/credentials
VITE_GOOGLE_MAPS_API_KEY=AIzaSy...

# Push Notifications (Optional)
# VAPID public key for Web Push notifications
VITE_VAPID_PUBLIC_KEY=BG...
# Endpoint for push notification subscription management
VITE_PUSH_ENDPOINT=https://your-api.com/api/push/subscribe

# Monitoring & Observability (Optional)
# Sentry DSN for error tracking
VITE_SENTRY_DSN=https://...@sentry.io/...
# Real User Monitoring endpoint for Web Vitals
VITE_RUM_ENDPOINT=https://your-rum-endpoint.com/vitals
# Structured logging endpoint
VITE_LOG_ENDPOINT=https://your-log-endpoint.com/logs

# ============================================
# Notes
# ============================================
# - All variables must start with VITE_ to be exposed to the client
# - These variables are embedded in the JavaScript bundle (public)
# - Never put secrets here (use Worker secrets instead)
# - For production, set these in Cloudflare Pages Dashboard:
#   Settings → Environment variables → Production
