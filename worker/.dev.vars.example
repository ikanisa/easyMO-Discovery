# Cloudflare Worker Local Development Environment Variables
# Copy this file to .dev.vars (git-ignored) for local development
# NEVER commit actual secrets to git
#
# Usage: wrangler dev (reads .dev.vars automatically)
# For production: Use 'wrangler secret put' or Cloudflare Dashboard

# ============================================
# Required Secrets (set via wrangler secret)
# ============================================

# OpenAI API Key
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-YOUR_OPENAI_API_KEY_HERE

# Supabase Configuration
# Get from: https://app.supabase.com/project/_/settings/api
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key-here

# ============================================
# Optional Secrets
# ============================================

# Supabase Service Role Key (for admin operations)
# ⚠️ WARNING: Never expose this to client-side code
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# Gemini API Key (for optional geocoding tools)
# Get from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# Google Maps API Key (for ETA calculations)
# Get from: https://console.cloud.google.com/apis/credentials
GOOGLE_MAPS_API_KEY=your-google-maps-api-key-here

# SerpAPI Key (for web search tools)
# Get from: https://serpapi.com/dashboard
SERPAPI_API_KEY=your-serpapi-key-here

# OAuth Configuration (for ChatGPT Apps SDK)
OAUTH_CLIENT_SECRET=your-oauth-client-secret-here

# Cron Secret (for authenticating cron job requests)
CRON_SECRET=generate-random-secret-here

# ============================================
# Optional Non-Secret Variables
# ============================================
# These can be set in wrangler.toml [vars] section or here

# Rate Limiting Configuration
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60

# OAuth Configuration (non-secret parts)
OAUTH_CLIENT_ID=your-oauth-client-id-here
OAUTH_REDIRECT_URI=https://your-worker-url.workers.dev/auth/callback
OAUTH_AUTHORIZATION_URL=https://oauth-provider.com/authorize
OAUTH_TOKEN_URL=https://oauth-provider.com/token

# Worker URL (self-referential, for OAuth redirects)
WORKER_URL=https://your-worker-name.your-subdomain.workers.dev

